NODE_ENV=development
PORT=3000

# Clerk authentication. The backend trusts only Clerk session tokens and
# derives the current user's clerk ID from the verified token subject.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Comma-separated frontend origins allowed to issue requests.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
CLERK_WEBHOOK_SIGNING_SECRET=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=skthon
DB_PASSWORD=change-me
DB_DATABASE=skthon
# Set true for Amazon RDS instances that enforce TLS connections.
DB_SSL=false

# Set this to true only when intentionally inspecting schema differences locally.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Seoul Open Data Plaza key used by `npm run import:floating-population`.
SEOUL_OPEN_DATA_API_KEY=

# Building ledger (BuildingHUB) lookup. Keep this key server-side.
BUILDING_HUB_SERVICE_KEY=
BUILDING_HUB_BASE_URL=https://apis.data.go.kr/1613000/BldRgstHubService
BUILDING_HUB_TIMEOUT_MS=5000

# Location recommendation agent
RECOMMENDATION_AGENT_MODE=codex
# deterministic for local tests; openai/codex require a configured MCP endpoint and API key
BUSINESS_LOCATION_AGENT_MODE=codex
# local: Docker Compose 기반 개발용 Codex runner, ecs: AWS Fargate runner
RECOMMENDATION_AGENT_RUNNER=local
RECOMMENDATION_MODEL=gpt-5.6-sol
OPENAI_API_KEY=
CODEX_MODEL=gpt-5.6-luna
CODEX_DOCKER_COMMAND=docker
CODEX_AGENT_COMPOSE_FILE=infra/ai/docker-compose.local.yml
# Keep completed Codex containers so their logs remain visible in Docker Desktop.
# Set true only when automatic removal is preferred.
CODEX_AGENT_REMOVE_CONTAINER=false
# Base64-encoded corporate TLS root CA PEM bundle. Leave empty outside a TLS-inspecting network.
CODEX_CA_CERTIFICATE_BASE64=
MCP_PORT=3001
# AWS Fargate runner (RECOMMENDATION_AGENT_RUNNER=ecs)
AWS_REGION=ap-northeast-2
ECS_CLUSTER=
ECS_TASK_DEFINITION_ARN=
ECS_TASK_SUBNET_IDS=
ECS_TASK_SECURITY_GROUP_IDS=
ECS_JOB_BUCKET=
ECS_TASK_CONTAINER_NAME=codex-agent
# Includes Fargate provisioning/image pull as well as the 105s Codex execution.
ECS_TASK_TIMEOUT_MS=300000
# Retry eventual/transient S3 reads after the task reaches STOPPED.
ECS_RESULT_READ_ATTEMPTS=5
ECS_RESULT_READ_DELAY_MS=750
RECOMMENDATION_MCP_SERVER_URL=
BUILDING_HUB_CACHE_TTL_DAYS=30
