{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "selectedCommercialArea", "recommendations", "warnings", "dataLimitations"],
  "properties": {
    "summary": { "type": "string" },
    "selectedCommercialArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "matchMethod", "overlapRatio", "distanceMeters"],
      "properties": {
        "code": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "matchMethod": { "type": ["string", "null"], "enum": ["OVERLAP", "NEAREST", null] },
        "overlapRatio": { "type": ["number", "null"] },
        "distanceMeters": { "type": ["number", "null"] }
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "businessCategoryCode", "businessCategoryName", "totalScore", "confidence", "oneLineReason", "evidence", "risks", "operatingTips"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
          "businessCategoryCode": { "type": "string" },
          "businessCategoryName": { "type": "string" },
          "totalScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "oneLineReason": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "metric", "value", "unit", "statisticsPeriod", "interpretation"],
              "properties": {
                "type": { "type": "string", "enum": ["BUILDING", "DEMAND", "COMPETITION", "POPULATION", "PROFILE", "RISK"] },
                "metric": { "type": "string" },
                "value": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "number" },
                    { "type": "null" },
                    { "type": "object", "additionalProperties": false, "properties": {}, "required": [] }
                  ]
                },
                "unit": { "type": ["string", "null"] },
                "statisticsPeriod": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["from", "to"],
                  "properties": {
                    "from": { "type": ["string", "null"] },
                    "to": { "type": ["string", "null"] }
                  }
                },
                "interpretation": { "type": "string" }
              }
            }
          },
          "risks": { "type": "array", "items": { "type": "string" } },
          "operatingTips": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "dataLimitations": { "type": "array", "items": { "type": "string" } }
  }
}
